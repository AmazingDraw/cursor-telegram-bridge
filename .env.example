# Telegram bot tokens from @BotFather (referenced by config.toml token_env)
TELEGRAM_BOT_TOKEN_1=
TELEGRAM_BOT_TOKEN_2=

# Cursor API key from https://cursor.com/dashboard -> Integrations
CURSOR_API_KEY=

# Your numeric Telegram user id. The bot ONLY responds to this id.
# Leave blank on first run: message the bot and it will reply with your id,
# then paste it here and restart.
ALLOWED_TELEGRAM_USER_ID=

# Optional token for the local web console (http://127.0.0.1:9477?token=...)
CONSOLE_TOKEN=

# Optional HTTP proxy for Telegram Bot API.
# Only set this if you are on pure HTTP-proxy mode (no TUN / fake-ip).
# With Stash/Clash TUN enabled, leave this unset — forcing :7890 breaks polling.
# HTTPS_PROXY=http://127.0.0.1:7890
